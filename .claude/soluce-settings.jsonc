{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    // télémétrie
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(bats *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      // outils externes
      "mcp__mcp-ssh",
      "mcp__mcp-docker",
      "mcp__mcp-ansible",
      "mcp__github__*",
      "mcp__gitlab__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      // pourrait bypasser l'outil WebFetch
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}