# Copy to .env and replace this path with your host Claude Code plugin cache.
# Windows example: CLAUDE_PLUGIN_ROOT=C:/Users/your-user/.claude/plugins
# Ubuntu example: CLAUDE_PLUGIN_ROOT=/home/your-user/.claude/plugins
CLAUDE_PLUGIN_ROOT=

# Prefer logging into Claude Code interactively. Use an API key only when needed.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com